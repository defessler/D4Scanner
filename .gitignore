# --- .NET build outputs ---
bin/
obj/
*.user
publish/

# --- IDE ---
.idea/
.vs/

# --- caches / scratch ---
.cache/
.verify/
__pycache__/
*.pyc
*.tmp
*.log
# TTS regression fixtures under samples/ are tracked by intent (override *.log above)
!samples/*.log
_inline.js
_harness.js
_verify.js

# --- native build artifacts (regenerated by build-and-install.ps1) ---
# Note: dll/saapi64.dll and dll/d4scanner-tts.cer ARE committed (pre-built binaries
# for users without MSVC); only the intermediate build outputs are ignored here.
dll/*.lib
dll/*.exp
dll/*.obj

# --- packaged add-on (regenerated by setup-nvda.ps1; source lives in nvda-addon/) ---
d4scanner.nvda-addon

# --- generated capture / diff / report artifacts (regenerated by the tools) ---
target.json
build.json
d4-report.html
live_build.json
parser/gear.json
parser/live_build.json
samples/sample_gear.json
samples/sample_vision_out.json
samples/sample_build.json
samples/real_build.json
