{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D4Scanner target build (what you are aiming at)",
  "type": "object",
  "required": ["schemaVersion", "name"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string" },
    "class": { "type": ["string", "null"] },
    "source": { "type": ["string", "null"], "description": "planner URL the target came from" },
    "gear": {
      "type": "array",
      "description": "Required affixes per slot. slot uses ring1/ring2 etc; matcher pools by base slot.",
      "items": {
        "type": "object",
        "required": ["slot", "affixes"],
        "properties": {
          "slot": { "type": "string" },
          "label": { "type": ["string", "null"] },
          "affixes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "uniques": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "slot": { "type": ["string", "null"] },
          "mythic": { "type": "boolean" }
        }
      }
    },
    "aspects": { "type": "array", "items": { "type": "string" } },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "rank": { "type": ["integer", "null"] }
        }
      }
    },
    "keyPassives": { "type": "array", "items": { "type": "string" } },
    "paragon": {
      "type": "object",
      "properties": {
        "boards": { "type": "array", "items": { "type": "string" } },
        "glyphs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "level": { "type": ["integer", "null"] }
            }
          }
        }
      }
    }
  }
}
