{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D4Scanner unified live-build capture",
  "type": "object",
  "required": ["schemaVersion", "gear"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capturedAt": { "type": "string", "description": "ISO timestamp" },
    "character": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "class": { "type": ["string", "null"] },
        "level": { "type": ["integer", "null"] }
      }
    },
    "gear": {
      "type": "array",
      "description": "Equipped items (TTS channel).",
      "items": {
        "type": "object",
        "properties": {
          "slot": { "type": ["string", "null"], "description": "helm|chest|gloves|pants|boots|amulet|ring|weapon|offhand" },
          "name": { "type": "string" },
          "rarity": { "type": ["string", "null"] },
          "itemType": { "type": ["string", "null"] },
          "itemPower": { "type": ["integer", "null"] },
          "isUnique": { "type": "boolean" },
          "isMythic": { "type": "boolean" },
          "isAncestral": { "type": "boolean" },
          "masterworkRank": { "type": ["integer", "null"] },
          "masterworkMax": { "type": ["integer", "null"] },
          "temperUsed": { "type": ["integer", "null"] },
          "temperMax": { "type": ["integer", "null"] },
          "aspect": { "type": ["string", "null"] },
          "affixes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "value": { "type": ["number", "null"] },
                "min": { "type": ["number", "null"] },
                "max": { "type": ["number", "null"] },
                "isPercent": { "type": "boolean" },
                "isMultiplier": { "type": "boolean" },
                "isGreater": { "type": "boolean" }
              },
              "required": ["text"]
            }
          },
          "powerText": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name"]
      }
    },
    "aspects": {
      "type": "array",
      "description": "Legendary aspect names (vision/codex channel).",
      "items": { "type": "string" }
    },
    "skills": {
      "type": "array",
      "description": "Active skills + key passives (vision channel).",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "rank": { "type": ["integer", "null"] },
          "isKeyPassive": { "type": "boolean" },
          "slotted": { "type": "boolean" }
        },
        "required": ["name"]
      }
    },
    "paragon": {
      "type": "array",
      "description": "Equipped boards + socketed glyph + glyph level (vision channel).",
      "items": {
        "type": "object",
        "properties": {
          "board": { "type": "string" },
          "glyph": { "type": ["string", "null"] },
          "glyphLevel": { "type": ["integer", "null"] },
          "notables": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["board"]
      }
    },
    "sources": {
      "type": "object",
      "description": "Which capture channel produced each section.",
      "additionalProperties": { "type": "string" }
    }
  }
}
