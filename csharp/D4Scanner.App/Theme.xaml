<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ palette: Diablo IV menu — cool grey/black + red accent (rarity colors for items only) ============ -->
  <SolidColorBrush x:Key="Bg"        Color="#0E0E11"/>
  <SolidColorBrush x:Key="Surface"   Color="#16171B"/>
  <SolidColorBrush x:Key="SurfaceHi" Color="#1E2026"/>
  <SolidColorBrush x:Key="SurfaceSel" Color="#262029"/>
  <SolidColorBrush x:Key="Line"      Color="#2A2C33"/>
  <SolidColorBrush x:Key="Edge"      Color="#3A3D45"/>
  <SolidColorBrush x:Key="EdgeHi"    Color="#565A64"/>
  <SolidColorBrush x:Key="Ink"       Color="#E7E8EC"/>
  <SolidColorBrush x:Key="Soft"      Color="#9DA1AB"/>
  <SolidColorBrush x:Key="Faint"     Color="#6B6E78"/>
  <SolidColorBrush x:Key="Accent"    Color="#D23B3B"/>
  <SolidColorBrush x:Key="AccentHi"  Color="#E85C5C"/>
  <SolidColorBrush x:Key="AccentDim" Color="#8E2A2A"/>
  <SolidColorBrush x:Key="Steel"     Color="#6E8CA8"/>
  <SolidColorBrush x:Key="Green"     Color="#4FB05A"/>
  <SolidColorBrush x:Key="Amber"     Color="#E0A52E"/>
  <SolidColorBrush x:Key="Red"       Color="#D23B3B"/>
  <!-- rarity -->
  <SolidColorBrush x:Key="Magic"     Color="#6E9BD6"/>
  <SolidColorBrush x:Key="Rare"      Color="#E5C84A"/>
  <SolidColorBrush x:Key="Legend"    Color="#E08A3C"/>
  <SolidColorBrush x:Key="Unique"    Color="#C9A45C"/>
  <SolidColorBrush x:Key="Mythic"    Color="#D1492E"/>

  <!-- ============ Button ============ -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHi}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource EdgeHi}"/>
              <Setter Property="Foreground" Value="{StaticResource AccentHi}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceSel}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- primary (crimson) button -->
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="3" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="#8E2A2A">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#E04C4C" Offset="0"/><GradientStop Color="#B22F2F" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.9"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- caption (window) buttons -->
  <Style x:Key="Caption" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Soft}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#26D23B3B"/>
              <Setter Property="Foreground" Value="{StaticResource AccentHi}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ TextBox ============ -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
    <Setter Property="Background" Value="#0C0C0F"/>
    <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ Slider ============ -->
  <Style TargetType="Thumb" x:Key="AccentThumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="16" Height="16">
            <Ellipse Fill="{StaticResource AccentHi}" Stroke="#11100D" StrokeThickness="2"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="5" CornerRadius="2" Background="#2A2C33" BorderBrush="#0A0A0C" BorderThickness="1"/>
            <Track x:Name="PART_Track">
              <Track.Thumb><Thumb Style="{StaticResource AccentThumb}"/></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ ListBox (autocomplete / dropdowns) ============ -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Padding" Value="13,9"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHi}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceSel}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ ScrollBar (slim) ============ -->
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="Transparent" Padding="2">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Background="#3A3D45"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============ ProgressBar (rounded, crimson) ============ -->
  <Style TargetType="ProgressBar">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border CornerRadius="3" Background="#1A1B20" BorderBrush="#0A0A0C" BorderThickness="1" ClipToBounds="True">
            <Grid>
              <Border x:Name="PART_Track"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#B22F2F" Offset="0"/><GradientStop Color="#E85C5C" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
