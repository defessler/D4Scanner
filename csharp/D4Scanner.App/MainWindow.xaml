<Window x:Class="D4Scanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D4Scanner — Live Build Tracker" Height="1180" Width="1180"
        Background="#241E18" FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="Margin" Value="6,0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="24,18">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#2A1212" Offset="0"/>
          <GradientStop Color="#6E2320" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <DockPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
            <Button x:Name="VisionBtn" Content="Paragon/Skills…" ToolTip="capture paragon + skills from screenshots (needs ANTHROPIC_API_KEY)"/>
            <Button x:Name="TargetBtn" Content="Target…"/>
            <Button x:Name="LogBtn" Content="Log…"/>
            <Button x:Name="TopmostBtn" Content="Pin"/>
          </StackPanel>
          <TextBlock x:Name="BuildName" Text="D4Scanner — Live Build Tracker"
                     Foreground="#F7EFE6" FontSize="32" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- grab a build straight from a Maxroll URL -->
        <DockPanel Margin="0,14,0,0">
          <TextBlock Text="Maxroll build:" Foreground="#E7C9A0" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button x:Name="ImportBtn" Content="Import" DockPanel.Dock="Right"/>
          <TextBox x:Name="ProfileBox" DockPanel.Dock="Right" Width="170" Margin="8,0,0,0"
                   ToolTip="profile to use, e.g. Endgame (optional)"/>
          <TextBox x:Name="UrlBox" ToolTip="paste a Maxroll build-guide or planner URL, then Import"/>
        </DockPanel>

        <DockPanel Margin="0,14,0,0">
          <TextBlock x:Name="OverallPct" Text="—" Foreground="#FFFFFF" FontSize="52" FontWeight="Bold"/>
          <TextBlock x:Name="OverallCount" Text="" Foreground="#E7C9A0" FontSize="22"
                     VerticalAlignment="Bottom" Margin="18,0,0,8" TextWrapping="Wrap"/>
        </DockPanel>
        <ProgressBar x:Name="OverallBar" Height="18" Minimum="0" Maximum="100" Value="0"
                     Margin="0,12,0,0" Foreground="#D9B85A" Background="#3A241A" BorderThickness="0"/>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <TextBlock Text="flag rolls under" Foreground="#E7C9A0" FontSize="20" VerticalAlignment="Center"/>
          <Slider x:Name="ThreshSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="5"
                  IsSnapToTickEnabled="True" Width="300" Margin="14,0,12,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="ThreshLbl" Text="50%" Foreground="#FFD98C" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
      <StackPanel x:Name="Body" Margin="22"/>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#1E1813" Padding="22,11">
      <TextBlock x:Name="Status" Foreground="#9A8A72" FontSize="18" Text="starting…" TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</Window>
