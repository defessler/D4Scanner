<Window x:Class="D4Scanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D4Scanner" Height="1040" Width="1300" MinWidth="860" MinHeight="620"
        WindowStyle="None" Background="{StaticResource Bg}"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid x:Name="RootLayer">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- title bar (drag region) -->
      <Grid Grid.Row="0" Height="48" Background="#121316">
        <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
          <TextBlock Text="◆" Foreground="{StaticResource Accent}" FontSize="15" VerticalAlignment="Center"/>
          <TextBlock Text="D4Scanner" Foreground="{StaticResource Ink}" FontSize="15.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Text="live build tracker" Foreground="{StaticResource Faint}" FontSize="13" Margin="11,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="TopmostBtn" Style="{StaticResource Caption}" Content="Pin" FontSize="13" Width="58"/>
          <Button x:Name="MinBtn" Style="{StaticResource Caption}" Content="—"/>
          <Button x:Name="CloseBtn" Style="{StaticResource Caption}" Content="✕"/>
        </StackPanel>
      </Grid>

      <!-- header -->
      <Border Grid.Row="1" Padding="24,18,24,20" BorderThickness="0,0,0,1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1B20" Offset="0"/><GradientStop Color="#0E0E11" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00D23B3B" Offset="0"/><GradientStop Color="#88D23B3B" Offset="0.5"/><GradientStop Color="#00D23B3B" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <StackPanel>
          <!-- title + actions -->
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="BuildName" Grid.Column="0" Text="No build loaded" Foreground="{StaticResource Ink}"
                       FontFamily="pack://application:,,,/Assets/Fonts/#Cinzel" FontSize="30" FontWeight="Bold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ProfileBtn" Content="Profile" FontSize="14" Visibility="Collapsed" Margin="0,0,9,0"/>
              <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileBtn}" Placement="Bottom"
                     StaysOpen="False" AllowsTransparency="True">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        CornerRadius="4" Margin="0,4,0,0">
                  <ListBox x:Name="ProfileList" MinWidth="170" MaxHeight="320"/>
                </Border>
              </Popup>
              <Button x:Name="OpenSrcBtn" Content="Open on Maxroll" FontSize="14" Visibility="Collapsed" Margin="0,0,9,0"/>
              <Button x:Name="NextBtn" Content="Next Steps" FontSize="14" Margin="0,0,9,0"/>
              <Button x:Name="RawBtn" Content="Build details" FontSize="14"/>
              <Button x:Name="VisionBtn" Content="Paragon / Skills" FontSize="14" Margin="9,0,0,0"/>
              <Button x:Name="TargetBtn" Content="Builds" FontSize="14" Margin="9,0,0,0"/>
              <Popup x:Name="BuildsPopup" PlacementTarget="{Binding ElementName=TargetBtn}" Placement="Bottom"
                     StaysOpen="False" AllowsTransparency="True">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        CornerRadius="4" Margin="0,4,0,0">
                  <ListBox x:Name="BuildsList" MinWidth="220" MaxHeight="380"/>
                </Border>
              </Popup>
              <Button x:Name="LogBtn" Content="Log" FontSize="14" Margin="9,0,0,0"/>
            </StackPanel>
          </Grid>

          <!-- smart import: one box (search guides or paste a URL) + fuzzy autocomplete -->
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <TextBox x:Name="UrlBox" HorizontalContentAlignment="Left" TextAlignment="Left"
                       ToolTip="Type a build name to search, or paste a Maxroll build-guide / planner URL"/>
              <TextBlock x:Name="UrlPlaceholder" IsHitTestVisible="False" Foreground="{StaticResource Faint}"
                         Text="Search builds  (e.g. dance of knives)  or paste a Maxroll URL…"
                         FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="22.5,0,0,0"/>
              <Popup x:Name="AcPopup" PlacementTarget="{Binding ElementName=UrlBox}" Placement="Bottom"
                     StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=UrlBox}">
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        CornerRadius="4" Margin="0,4,0,0">
                  <StackPanel>
                    <WrapPanel x:Name="AcChips" Margin="9,9,9,3"/>
                    <ListBox x:Name="AcList" MaxHeight="340"/>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>
            <Button x:Name="ImportBtn" Grid.Column="1" Style="{StaticResource Primary}" Content="Import" Padding="28,8" Margin="10,0,0,0"/>
          </Grid>

          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
              <TextBlock x:Name="OverallPct" Text="—" Foreground="{StaticResource Accent}" FontSize="50" FontWeight="Bold"/>
              <TextBlock x:Name="OverallCount" Text="" Foreground="{StaticResource Soft}" FontSize="15"
                         VerticalAlignment="Bottom" Margin="18,0,0,11" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="28,0,0,8">
              <ProgressBar x:Name="OverallBar" Height="14" Minimum="0" Maximum="100" Value="0"/>
              <DockPanel Margin="0,14,0,0">
                <TextBlock x:Name="ThreshLbl" Text="75%" Foreground="{StaticResource Accent}" FontSize="14.5" FontWeight="SemiBold"
                           DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Text="flag rolls under" Foreground="{StaticResource Soft}" FontSize="14.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Slider x:Name="ThreshSlider" Minimum="0" Maximum="100" Value="75" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- body -->
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <ScrollViewer.Background>
          <RadialGradientBrush GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.95">
            <GradientStop Color="#17181D" Offset="0"/><GradientStop Color="#0E0E11" Offset="1"/>
          </RadialGradientBrush>
        </ScrollViewer.Background>
        <StackPanel x:Name="Body" Margin="24,20,24,24"/>
      </ScrollViewer>

      <!-- status bar -->
      <Border Grid.Row="3" Background="#0A0A0D" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0" Padding="22,8">
        <DockPanel>
          <Button x:Name="InstallCaptureBtn" DockPanel.Dock="Right" Style="{StaticResource Primary}"
                  Content="Install capture DLL" FontSize="12.5" Padding="14,4" Margin="12,0,0,0" Visibility="Collapsed"/>
          <TextBlock x:Name="Status" Foreground="{StaticResource Faint}" FontSize="13" Text="starting…"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </Grid>

    <!-- compare drawer overlay: slides in from the right; hidden until a slot is pinned/opened -->
    <Border x:Name="DrawerHost" HorizontalAlignment="Right" Margin="0,49,0,0" Visibility="Collapsed"
            Background="#101116" BorderBrush="{StaticResource Edge}" BorderThickness="1,0,0,0" Width="430"/>

    <!-- toast overlay: transient, non-blocking confirmations (bottom-center, above the status bar) -->
    <StackPanel x:Name="ToastHost" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,52" IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
