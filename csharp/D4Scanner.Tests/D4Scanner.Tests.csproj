<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dependency-free test console (mirrors tracker/diff.test.js): `dotnet run` it; exits non-zero on failure.
       No xUnit/NUnit so it restores with nothing beyond what Core already pulls. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\D4Scanner.Core\D4Scanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the canonical TTS regression fixtures, copied next to the test exe so the path is stable -->
    <None Include="..\..\samples\sample_tts.log" Link="sample_tts.log" CopyToOutputDirectory="PreserveNewest" />
    <!-- a real, full-loadout S8 Rogue capture (bow + dual-wield melee, amulet, pants, runewords, double-hover) -->
    <None Include="..\..\samples\sample_tts_rogue_s8.log" Link="sample_tts_rogue_s8.log" CopyToOutputDirectory="PreserveNewest" />
    <!-- Season 13 / Lord of Hatred: Greater Affixes, Quality system, Tempers denominators, Damage Multipliers -->
    <None Include="..\..\samples\sample_tts_s13.log" Link="sample_tts_s13.log" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
