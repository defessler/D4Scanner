<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Maintenance tool: regenerates D4Scanner.Core/Assets/icon_atlas_map.json (the bundled
    handle to atlas map used by GameDataIcons). Run after a Diablo IV patch that adds items
    or re-bakes the 2DInventory atlases. Requires D4 installed + internet (fetches DiabloTools/d4data).
    Usage: run this project with optional args [gameDir] [outFile].
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\third_party\CascLib\CascLib\CascLib.csproj" />
  </ItemGroup>
</Project>
