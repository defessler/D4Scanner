<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\third_party\CascLib\CascLib\CascLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- bundled handle->atlas map for game-data icon extraction (generated from DiabloTools/d4data) -->
    <EmbeddedResource Include="Assets\icon_atlas_map.json" />
    <!-- season-volatile guidance data (activity copy, spoils, boss ladder, tier gates, crafting constants) -->
    <EmbeddedResource Include="Assets\season_pack.json" />
  </ItemGroup>
</Project>
